{
  "name": "credo-ext",
  "private": true,
  "license": "Apache-2.0",
  "description": "Monorepo containing extensions for Credo",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "type": "module",
  "repository": {
    "url": "https://github.com/openwallet-foundation/credo-ts-ext",
    "type": "git"
  },
  "scripts": {
    "types:check": "tsc -p tsconfig.json --noEmit",
    "style:check": "biome check --unsafe",
    "style:fix": "biome check --write --unsafe",
    "build": "pnpm -r --parallel run build",
    "test": "vitest",
    "test:unit": "pnpm test --project unit",
    "test:e2e": "pnpm test --project e2e",
    "validate": "pnpm types:check && pnpm style:check",
    "release": "pnpm build && pnpm changeset publish",
    "changeset-version": "pnpm changeset version && pnpm style:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^3.0.3",
    "@credo-ts/askar": "catalog:",
    "@credo-ts/core": "catalog:",
    "@credo-ts/node": "catalog:",
    "@openwallet-foundation/askar-nodejs": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "reflect-metadata": "catalog:",
    "tsdown": "^0.23.4",
    "typescript": "catalog:",
    "unrun": "^0.3.1",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
