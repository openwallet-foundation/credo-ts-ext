{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": ["packages", "samples", "tests", "*.ts"],
  "exclude": ["node_modules", "**/node_modules/**", "build", "**/build/**", "**/cli-build/**", "**/.pnpm/**"]
}
