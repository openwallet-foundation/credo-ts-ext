{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 10000000
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/build",
      "!**/.idea",
      "!**/coverage",
      "!**/pnpm-lock.yaml",
      "!**/.changeset"
    ]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "lineWidth": 120,
      "indentStyle": "space"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "packages/*": "using imports from packages/* is not allowed"
            }
          }
        }
      },
      "correctness": {
        "noUnusedVariables": { "level": "error", "fix": "safe" },
        "noUnusedFunctionParameters": "off",
        "noUnusedImports": "error",
        "noUndeclaredDependencies": "off",
        "noInvalidUseBeforeDeclaration": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noImportCycles": "error"
      },
      "complexity": {
        "noBannedTypes": "error"
      },
      "performance": {
        "noDelete": { "fix": "none", "level": "error" }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/__tests__/**",
        "**/vitest.*.ts",
        "**/samples/**",
        "**/scripts/**",
        "**/tests/**"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noNonNullAssertedOptionalChain": "off" },
          "complexity": { "useArrowFunction": "off" },
          "correctness": { "noUndeclaredDependencies": "off" }
        }
      }
    }
  ]
}
