{
  "name": "@credo-ts/rest",
  "main": "build/index",
  "type": "module",
  "types": "build/index",
  "version": "0.10.2",
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "description": "Rest API for using Credo over HTTP",
  "homepage": "https://github.com/openwallet-foundation/credo-ts-ext/tree/main/packages/rest",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation/credo-ts-ext",
    "directory": "packages/rest"
  },
  "bin": {
    "credo-rest": "bin/credo-rest.js"
  },
  "scripts": {
    "tsoa": "tsoa spec-and-routes && tsc -p tsconfig.build.json",
    "dev": "yarn tsoa && tsnd --respawn samples/sampleWithApp.ts",
    "sample": "yarn tsoa && tsnd --respawn samples/sample.ts",
    "sample:with-app": "yarn tsoa && tsx samples/sampleWithApp.ts",
    "sample:cli-config": "yarn tsoa && tsx src/cli.ts --config ./samples/cliConfig.json",
    "sample:cli": "yarn tsoa && sh samples/sampleCli.sh",
    "build": "yarn run clean && yarn run compile",
    "clean": "rimraf -rf ./build",
    "compile": "yarn tsoa && tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn run build",
    "test": "jest"
  },
  "dependencies": {
    "@credo-ts/anoncreds": "^0.6.1",
    "@credo-ts/askar": "^0.6.1",
    "@credo-ts/cheqd": "^0.6.1",
    "@credo-ts/core": "^0.6.1",
    "@credo-ts/didcomm": "^0.6.1",
    "@credo-ts/indy-vdr": "^0.6.1",
    "@credo-ts/node": "^0.6.1",
    "@credo-ts/openid4vc": "^0.6.1",
    "@credo-ts/tenants": "^0.6.1",
    "@hyperledger/anoncreds-nodejs": "0.3.1",
    "@hyperledger/indy-vdr-nodejs": "0.2.2",
    "@openwallet-foundation/askar-nodejs": "^0.4.3",
    "@sphereon/oid4vc-common": "^0.20.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "@types/ref-array-di": "^1.2.8",
    "@types/ws": "^7.4.7",
    "body-parser": "^1.20.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "node-fetch": "^2.6.7",
    "swagger-ui-express": "^5.0.0",
    "tslog": "^4.10.0",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.7.0",
    "uint8arrays": "^3.1.1",
    "ws": "^7.5.3",
    "yargs": "^17.3.1"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.7.10",
    "@types/node-fetch": "^2.6.4",
    "@types/ref-struct-di": "^1.1.9",
    "@types/supertest": "^2.0.12",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/uuid": "^8.3.4",
    "@types/yargs": "^17.0.35",
    "did-resolver": "^4.1.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.0.1",
    "rxjs": "^7.8.1",
    "supertest": "^6.2.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0"
  },
  "ts-node": {
    "esm": true
  },
  "pnpm": {
    "overrides": {
      "uint8arrays": "3.1.1"
    },
    "patchedDependencies": {
      "@credo-ts/indy-vdr@0.6.1": "patches/@credo-ts__indy-vdr@0.6.1.patch",
      "@credo-ts/anoncreds@0.6.1": "patches/@credo-ts__anoncreds@0.6.1.patch"
    }
  }
}
